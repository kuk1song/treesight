{"isSidechain": false, "userType": "external", "cwd": "/home/dev/tidepool", "sessionId": "953c0ab1-134d-56c9-9224-a2eb69918a2a", "version": "2.1.299", "gitBranch": "main", "entrypoint": "cli", "type": "user", "timestamp": "2026-09-14T09:31:47.000Z", "message": {"role": "user", "content": "I imported tides.ics into my calendar and every tide is one hour late. What's going on?"}, "origin": {"kind": "human"}, "promptSource": "typed", "permissionMode": "default", "uuid": "294e9ac0-ce07-544e-a45f-9052a18c3177", "parentUuid": "4f9c8aa4-e270-5455-9fa8-65f4d2d44aa4"}
