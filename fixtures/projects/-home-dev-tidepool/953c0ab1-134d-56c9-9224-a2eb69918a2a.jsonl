{"isSidechain": false, "userType": "external", "cwd": "/home/dev/tidepool", "sessionId": "953c0ab1-134d-56c9-9224-a2eb69918a2a", "version": "2.1.299", "gitBranch": "main", "entrypoint": "cli", "type": "assistant", "timestamp": "2026-09-14T09:40:19.000Z", "message": {"role": "assistant", "model": "claude-opus-5-5", "type": "message", "content": [{"type": "text", "text": "Found it: the export writes DTSTART as floating local time with no time zone, and your calendar reads floating times in its own zone, which is on summer time, so everything shifts by one hour. The data itself is right. The fix is to write every time in UTC with a trailing Z."}]}, "uuid": "c8173b17-2dde-5489-85e0-8c23af6d4685", "parentUuid": "ec81d92c-3753-519a-990f-84f23e6ad214"}
